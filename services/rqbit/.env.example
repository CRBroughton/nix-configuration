# TS_AUTHKEY not needed here - tailscale-rqbit reads it from the shared
# agenix secret at /run/agenix/ts_authkey (see hosts/nixos-server/default.nix)
PIA_USER=            # Private Internet Access account username
PIA_PASSWORD=         # Private Internet Access account password
PIA_SERVER_REGIONS=UK London   # See https://github.com/qdm12/gluetun/wiki/Private-Internet-Access for valid region names
